# Copy to backend/.env and adjust. Never commit the real .env file.

# --- Application ---
APP_NAME="Streamer AI Engine"
APP_VERSION=0.4.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Leave empty to use <project>/storage/database/streamer_ai_engine.db
DATABASE_URL=

# --- Paths (empty = project defaults) ---
STORAGE_ROOT=
LOG_DIR=
CONFIG_DIR=

# --- AI (local, free models) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# --- Video ---
# "ffmpeg" uses PATH if installed, otherwise the copy bundled in the virtualenv (imageio-ffmpeg)
FFMPEG_BINARY=ffmpeg

# --- Recording ---
RECORDING_MAX_CONCURRENT=2
RECORDING_MAX_HOURS=12
# Live capture does not start when free disk space is below this
RECORDING_MIN_FREE_GB=5
RECORDING_MAX_UPLOAD_GB=20
RECORDING_FORMAT_SORT=res:1080

# --- Scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Europe/Istanbul

# --- Live stream tracking (official platform APIs) ---
TRACKING_ENABLED=true
# How often the scheduler wakes up; each platform is checked at its own interval below
TRACKING_TICK_SECONDS=60
TWITCH_POLL_INTERVAL_SECONDS=120
KICK_POLL_INTERVAL_SECONDS=120
YOUTUBE_POLL_INTERVAL_SECONDS=300
# Twitch: https://dev.twitch.tv/console -> Register application (secret)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Kick: https://kick.com/settings/developer -> Create app (secret)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# YouTube Data API v3 key: Google Cloud Console -> APIs & Services -> Credentials (secret)
YOUTUBE_API_KEY=

# --- YouTube Data API (OAuth 2.0) ---
# Create credentials in Google Cloud Console. Keep these values secret.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/oauth/callback
# Where the OAuth refresh token will be stored (outside of git)
YOUTUBE_TOKEN_FILE=
